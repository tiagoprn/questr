# Template only. Copy to app.env and fill in real values.
# Real app.env is gitignored and root-owned 0600 on the VM.

# Postgres (must match the compose db service: user questr, db questr_db).
POSTGRES_USER=questr
POSTGRES_DB=questr_db
POSTGRES_HOST=db
POSTGRES_PASSWORD=<same value as deploy/secrets/pg_password>

# Redis (must match deploy/secrets/redis_password).
REDIS_HOST=redis
REDIS_PASSWORD=<same value as deploy/secrets/redis_password>

# Uvicorn worker count (D5 placeholder: 2; retuned in Phase 2).
WEB_CONCURRENCY=2

# Public URL of the app (used by email links and CORS context).
APP_URL=<set the real https:// URL>
